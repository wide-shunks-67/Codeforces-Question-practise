#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
void solve(){
    int n,k;
    cin>>n>>k;
    vector<int>a(n);
    int a_even=0;
    int a_odd=0;
    for(int i=0;i<n;i++){
        cin>>a[i];
        if(a[i]%2==0){
            a_even++;
        }else a_odd++;
    }
    vector<int>b(n);
    int b_even=0;
    int b_odd=0;
    for(int i=0;i<n;i++){
        cin>>b[i];
        if(b[i]%2==0){
            b_even++;
        }else b_odd++;
    }
    if(k%2!=0){
        if (b_even > a_even) {
            cout << "NO
";
        } else {
            cout << "YES
";
        }
    }
    else{
        if(b_odd>a_odd){
            cout<<"No
";
        }else cout<<"Yes
";
    }
}
 int main(){
     int t;
     cin>>t;
     while(t--){
         solve();
     }
 }